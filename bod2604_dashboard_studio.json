{
  "title": "Mythos Era — BOD 26-04 Risk-Based Vulnerability Prioritization",
  "description": "Live prioritization of scanner findings using the CISA BOD 26-04 four-variable model. Base search: savedsearch 'BOD 26-04 Vulnerability Prioritization'.",
  "inputs": {
    "input_priority": {
      "type": "input.dropdown",
      "title": "Priority Tier",
      "options": {
        "items": [
          {"label": "All", "value": "*"},
          {"label": "P1 — Urgent (3 days)", "value": "P1"},
          {"label": "P2 — High (14 days)", "value": "P2"},
          {"label": "P3 — Medium (60 days)", "value": "P3"},
          {"label": "P4 — Planned (next upgrade)", "value": "P4"}
        ],
        "defaultValue": "*",
        "token": "sel_priority"
      }
    },
    "input_sla": {
      "type": "input.dropdown",
      "title": "SLA Status",
      "options": {
        "items": [
          {"label": "All", "value": "*"},
          {"label": "Overdue", "value": "overdue"},
          {"label": "Within SLA", "value": "within_sla"},
          {"label": "Next system upgrade", "value": "next_system_upgrade"}
        ],
        "defaultValue": "*",
        "token": "sel_sla"
      }
    }
  },
  "defaults": {
    "dataSources": {"ds.search": {"options": {"queryParameters": {"earliest": "-24h", "latest": "now"}}}}
  },
  "dataSources": {
    "ds_kpi_p1": {
      "type": "ds.search",
      "name": "P1 findings",
      "options": {"query": "| savedsearch \"BOD 26-04 Vulnerability Prioritization\"\n| where priority_label=\"P1\" | stats count"}
    },
    "ds_kpi_p1_overdue": {
      "type": "ds.search",
      "name": "P1 overdue",
      "options": {"query": "| savedsearch \"BOD 26-04 Vulnerability Prioritization\"\n| where priority_label=\"P1\" AND sla_status=\"overdue\" | stats count"}
    },
    "ds_kpi_forensic": {
      "type": "ds.search",
      "name": "Hosts needing forensic triage",
      "options": {"query": "| savedsearch \"BOD 26-04 Vulnerability Prioritization\"\n| where forensic_required=\"yes\" | stats dc(Host) as count"}
    },
    "ds_kpi_unscanned": {
      "type": "ds.search",
      "name": "Assets with no scan coverage",
      "options": {"query": "| inputlookup asset_data.csv\n| lookup asset_vulnerability_data.csv \"IP Address\" AS ip OUTPUTNEW CVE AS c1\n| lookup asset_vulnerability_data.csv \"IP Address\" AS ip_alt OUTPUTNEW CVE AS c2\n| where isnull(c1) AND isnull(c2)\n| stats count"}
    },
    "ds_severity": {
      "type": "ds.search",
      "name": "Findings by CVSS severity (the old way)",
      "options": {"query": "| inputlookup asset_vulnerability_data.csv\n| search \"Vulnerability State\"!=\"Fixed\"\n| stats count as Findings by Risk\n| eval order=case(Risk=\"Critical\",1,Risk=\"High\",2,Risk=\"Medium\",3,true(),4)\n| sort order | fields - order\n| rename Risk as Severity"}
    },
    "ds_sla_pie": {
      "type": "ds.search",
      "name": "SLA posture",
      "options": {"query": "| savedsearch \"BOD 26-04 Vulnerability Prioritization\"\n| stats count by sla_status"}
    },
    "ds_unscanned_list": {
      "type": "ds.search",
      "name": "Blind spots — assets never scanned",
      "options": {"query": "| inputlookup asset_data.csv\n| lookup asset_vulnerability_data.csv \"IP Address\" AS ip OUTPUTNEW CVE AS c1\n| lookup asset_vulnerability_data.csv \"IP Address\" AS ip_alt OUTPUTNEW CVE AS c2\n| where isnull(c1) AND isnull(c2)\n| table hostname ip bunit priority internet_asset_exposed owner\n| rename hostname as \"Host\", ip as \"IP\", bunit as \"Business Unit\", priority as \"Asset Priority\", internet_asset_exposed as \"Exposed\", owner as \"Owner\""}
    },
    "ds_tier_p1": {
      "type": "ds.search",
      "name": "P1 tile",
      "options": {"query": "| savedsearch \"BOD 26-04 Vulnerability Prioritization\"\n| where priority_label=\"P1\" | stats count"}
    },
    "ds_tier_p2": {
      "type": "ds.search",
      "name": "P2 tile",
      "options": {"query": "| savedsearch \"BOD 26-04 Vulnerability Prioritization\"\n| where priority_label=\"P2\" | stats count"}
    },
    "ds_tier_p3": {
      "type": "ds.search",
      "name": "P3 tile",
      "options": {"query": "| savedsearch \"BOD 26-04 Vulnerability Prioritization\"\n| where priority_label=\"P3\" | stats count"}
    },
    "ds_tier_p4": {
      "type": "ds.search",
      "name": "P4 tile",
      "options": {"query": "| savedsearch \"BOD 26-04 Vulnerability Prioritization\"\n| where priority_label=\"P4\" | stats count"}
    },
    "ds_worklist": {
      "type": "ds.search",
      "name": "Prioritized worklist",
      "options": {"query": "| savedsearch \"BOD 26-04 Vulnerability Prioritization\"\n| search priority_label=\"$sel_priority$\" sla_status=\"$sel_sla$\"\n| table priority_label forensic_required Host cve kev_name cvss in_kev exploitation automatable technical_impact exposed elevated asset_priority bunit owner due_date sla_status\n| rename priority_label as Priority, forensic_required as \"Forensic\", cve as CVE, kev_name as \"KEV Name\", cvss as CVSS, in_kev as \"In KEV\", exploitation as Exploitation, automatable as Automatable, technical_impact as \"Tech Impact\", exposed as Exposed, elevated as Elevated, asset_priority as \"Asset Priority\", bunit as \"Business Unit\", owner as Owner, due_date as \"Due Date\", sla_status as \"SLA Status\""}
    }
  },
  "visualizations": {
    "eyebrow": {
      "type": "splunk.markdown",
      "options": {"markdown": "MYTHOS ERA — RISK-BASED VULNERABILITY MANAGEMENT | CISA BOD 26-04", "fontColor": "#39C6D6", "backgroundColor": "#0D1524", "fontSize": "small"}
    },
    "main_title": {
      "type": "splunk.markdown",
      "options": {"markdown": "# BOD 26-04 Vulnerability Prioritization", "fontColor": "#E7ECF5", "backgroundColor": "#0D1524", "fontSize": "large"}
    },
    "main_sub": {
      "type": "splunk.markdown",
      "options": {"markdown": "Exploit weaponization is measured in hours. Priorities below combine **Public Exposure × KEV × Automatable × Technical Impact** (CISA-published data), re-evaluated on every run — a KEV addition overnight automatically escalates the affected findings.", "fontColor": "#8B98AC", "backgroundColor": "#0D1524", "fontSize": "default"}
    },
    "kpi_p1": {
      "type": "splunk.singlevalue",
      "dataSources": {"primary": "ds_kpi_p1"},
      "title": "P1 — Fix within 3 days",
      "options": {"majorColor": "#FF4D5E", "backgroundColor": "#0D1420", "unit": "findings", "unitPosition": "after", "underLabel": "Exposed + actively exploited (KEV)", "showSparkline": false, "showTrend": false}
    },
    "kpi_p1_overdue": {
      "type": "splunk.singlevalue",
      "dataSources": {"primary": "ds_kpi_p1_overdue"},
      "title": "P1 OVERDUE",
      "options": {"majorColor": "#FF4D5E", "backgroundColor": "#1A0D12", "unit": "findings", "unitPosition": "after", "underLabel": "Past the 3-day SLA — needs answers today", "showSparkline": false, "showTrend": false}
    },
    "kpi_forensic": {
      "type": "splunk.singlevalue",
      "dataSources": {"primary": "ds_kpi_forensic"},
      "title": "Forensic triage required",
      "options": {"majorColor": "#FFA23E", "backgroundColor": "#0D1420", "unit": "hosts", "unitPosition": "after", "underLabel": "Assume-compromise check (P1 hosts)", "showSparkline": false, "showTrend": false}
    },
    "kpi_unscanned": {
      "type": "splunk.singlevalue",
      "dataSources": {"primary": "ds_kpi_unscanned"},
      "title": "Blind spots — never scanned",
      "options": {"majorColor": "#FFD666", "backgroundColor": "#0D1420", "unit": "assets", "unitPosition": "after", "underLabel": "In inventory, zero scanner findings", "showSparkline": false, "showTrend": false}
    },
    "sec1_title": {
      "type": "splunk.markdown",
      "options": {"markdown": "### The old way — CVSS severity alone", "fontColor": "#E7ECF5", "backgroundColor": "#101827"}
    },
    "severity_table": {
      "type": "splunk.table",
      "dataSources": {"primary": "ds_severity"},
      "options": {
        "backgroundColor": "#0D1420", "count": 5, "drilldown": "none", "showRowNumbers": false,
        "columnFormat": {
          "Severity": {"rowColors": "> table | seriesByName(\"Severity\") | matchValue(sevColor)"},
          "Findings": {"align": "right", "rowColors": "> table | seriesByName(\"Severity\") | matchValue(sevColor)"}
        }
      },
      "context": {
        "sevColor": [
          {"match": "Critical", "value": "#FF4D5E"},
          {"match": "High", "value": "#FFA23E"},
          {"match": "Medium", "value": "#FFD666"},
          {"match": "Low", "value": "#5B8DEF"}
        ]
      }
    },
    "sec2_title": {
      "type": "splunk.markdown",
      "options": {"markdown": "### SLA posture — are we on time?", "fontColor": "#E7ECF5", "backgroundColor": "#101827"}
    },
    "sla_pie": {
      "type": "splunk.pie",
      "dataSources": {"primary": "ds_sla_pie"},
      "options": {"backgroundColor": "#0D1420"}
    },
    "sec3_title": {
      "type": "splunk.markdown",
      "options": {"markdown": "### Blind spots — assets with no scan coverage", "fontColor": "#FF4D5E", "backgroundColor": "#101827"}
    },
    "unscanned_table": {
      "type": "splunk.table",
      "dataSources": {"primary": "ds_unscanned_list"},
      "options": {"backgroundColor": "#0D1420", "count": 10, "drilldown": "none", "showRowNumbers": false}
    },
    "tier_p1": {
      "type": "splunk.singlevalue",
      "dataSources": {"primary": "ds_tier_p1"},
      "title": "P1 — Urgent",
      "options": {"majorColor": "#FF4D5E", "backgroundColor": "#0D1420", "unit": "findings", "unitPosition": "after", "underLabel": "3 days + forensic triage", "showSparkline": false, "showTrend": false}
    },
    "tier_p2": {
      "type": "splunk.singlevalue",
      "dataSources": {"primary": "ds_tier_p2"},
      "title": "P2 — High",
      "options": {"majorColor": "#FFA23E", "backgroundColor": "#0D1420", "unit": "findings", "unitPosition": "after", "underLabel": "Within 14 days", "showSparkline": false, "showTrend": false}
    },
    "tier_p3": {
      "type": "splunk.singlevalue",
      "dataSources": {"primary": "ds_tier_p3"},
      "title": "P3 — Medium",
      "options": {"majorColor": "#FFD666", "backgroundColor": "#0D1420", "unit": "findings", "unitPosition": "after", "underLabel": "Within 60 days", "showSparkline": false, "showTrend": false}
    },
    "tier_p4": {
      "type": "splunk.singlevalue",
      "dataSources": {"primary": "ds_tier_p4"},
      "title": "P4 — Planned",
      "options": {"majorColor": "#94A3BC", "backgroundColor": "#0D1420", "unit": "findings", "unitPosition": "after", "underLabel": "At next system upgrade", "showSparkline": false, "showTrend": false}
    },
    "worklist_title": {
      "type": "splunk.markdown",
      "options": {"markdown": "## Prioritized worklist — filtered by the selectors above\nEach row: one vulnerability on one asset, with owner and deadline. Sorted P1-first, earliest due date on top.", "fontColor": "#39C6D6", "backgroundColor": "#101827"}
    },
    "worklist": {
      "type": "splunk.table",
      "dataSources": {"primary": "ds_worklist"},
      "options": {
        "backgroundColor": "#0D1420", "count": 25, "drilldown": "none", "showRowNumbers": false,
        "columnFormat": {
          "Priority": {
            "rowBackgroundColors": "> table | seriesByName(\"Priority\") | matchValue(pColor)",
            "rowColors": "> table | seriesByName(\"Priority\") | pick(whiteText)"
          },
          "SLA Status": {"rowColors": "> table | seriesByName(\"SLA Status\") | matchValue(slaColor)"},
          "In KEV": {"rowColors": "> table | seriesByName(\"In KEV\") | matchValue(ynColor)"},
          "Exposed": {"rowColors": "> table | seriesByName(\"Exposed\") | matchValue(ynColor)"},
          "Automatable": {"rowColors": "> table | seriesByName(\"Automatable\") | matchValue(ynColor)"},
          "Forensic": {"rowColors": "> table | seriesByName(\"Forensic\") | matchValue(ynColor)"},
          "Elevated": {"rowColors": "> table | seriesByName(\"Elevated\") | matchValue(elevColor)"}
        }
      },
      "context": {
        "pColor": [
          {"match": "P1", "value": "#FF4D5E"},
          {"match": "P2", "value": "#FFA23E"},
          {"match": "P3", "value": "#FFD666"},
          {"match": "P4", "value": "#5B8DEF"}
        ],
        "whiteText": ["#FFFFFF"],
        "slaColor": [
          {"match": "overdue", "value": "#FF4D5E"},
          {"match": "within_sla", "value": "#2ECC8F"},
          {"match": "next_system_upgrade", "value": "#94A3BC"}
        ],
        "ynColor": [
          {"match": "yes", "value": "#FF4D5E"},
          {"match": "no", "value": "#6F7D92"}
        ],
        "elevColor": [
          {"match": "yes", "value": "#39C6D6"},
          {"match": "no", "value": "#6F7D92"}
        ]
      }
    },
    "footer": {
      "type": "splunk.markdown",
      "options": {"markdown": "Sources: Tenable scan findings (asset_vulnerability_data) × Asset inventory (asset_data) × CISA KEV catalog (cisa_kev_lookup) × CISA Vulnrichment SSVC (cisa_vulnrichment_lookup via index=vuln_intel) | SLA model: CISA BOD 26-04", "fontColor": "#8B98AC", "backgroundColor": "#0A0F1A", "fontSize": "small"}
    }
  },
  "layout": {
    "type": "absolute",
    "globalInputs": ["input_priority", "input_sla"],
    "options": {"width": 1440, "height": 1560, "backgroundColor": "#0A0F1A", "display": "fit-to-width"},
    "structure": [
      {"item": "eyebrow", "type": "block", "position": {"x": 10, "y": 5, "w": 1420, "h": 22}},
      {"item": "main_title", "type": "block", "position": {"x": 10, "y": 27, "w": 1420, "h": 40}},
      {"item": "main_sub", "type": "block", "position": {"x": 10, "y": 67, "w": 1420, "h": 40}},
      {"item": "kpi_p1", "type": "block", "position": {"x": 10, "y": 115, "w": 350, "h": 115}},
      {"item": "kpi_p1_overdue", "type": "block", "position": {"x": 370, "y": 115, "w": 350, "h": 115}},
      {"item": "kpi_forensic", "type": "block", "position": {"x": 730, "y": 115, "w": 350, "h": 115}},
      {"item": "kpi_unscanned", "type": "block", "position": {"x": 1090, "y": 115, "w": 340, "h": 115}},
      {"item": "sec1_title", "type": "block", "position": {"x": 10, "y": 245, "w": 460, "h": 30}},
      {"item": "severity_table", "type": "block", "position": {"x": 10, "y": 278, "w": 460, "h": 250}},
      {"item": "sec2_title", "type": "block", "position": {"x": 490, "y": 245, "w": 460, "h": 30}},
      {"item": "sla_pie", "type": "block", "position": {"x": 490, "y": 278, "w": 460, "h": 250}},
      {"item": "sec3_title", "type": "block", "position": {"x": 970, "y": 245, "w": 460, "h": 30}},
      {"item": "unscanned_table", "type": "block", "position": {"x": 970, "y": 278, "w": 460, "h": 250}},
      {"item": "tier_p1", "type": "block", "position": {"x": 10, "y": 545, "w": 350, "h": 125}},
      {"item": "tier_p2", "type": "block", "position": {"x": 370, "y": 545, "w": 350, "h": 125}},
      {"item": "tier_p3", "type": "block", "position": {"x": 730, "y": 545, "w": 350, "h": 125}},
      {"item": "tier_p4", "type": "block", "position": {"x": 1090, "y": 545, "w": 340, "h": 125}},
      {"item": "worklist_title", "type": "block", "position": {"x": 10, "y": 685, "w": 1420, "h": 55}},
      {"item": "worklist", "type": "block", "position": {"x": 10, "y": 745, "w": 1420, "h": 750}},
      {"item": "footer", "type": "block", "position": {"x": 10, "y": 1505, "w": 1420, "h": 30}}
    ]
  }
}
