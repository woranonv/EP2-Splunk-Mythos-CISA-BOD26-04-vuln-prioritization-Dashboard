/* ============================================================
   GENERATOR 1 — Tenable findings for real EA scanned servers
   Run once in Search UI (time range: All time), then verify.
   Creates/overwrites: asset_vulnerability_data.csv (~300 rows)
   Logic:
   - only servers Tenable has seen (lastseen_12)
   - ~60% of servers get findings, 1-4 each (hash-deterministic)
   - CVEs assigned by OS family, weighted
   - First Discovered spread over last 90 days
   - stale-coverage servers keep old Last Observed (coverage-lapse story)
   ============================================================ */

| inputlookup ea_network_asset_inventory
| where asset_type="Server" AND isnotnull(lastseen_12)
| eval scan_state=if(lastseen_12>(now()-86400*5),"current","stale")
| eval os_norm=coalesce(os,os_platform,"Linux")
| eval os_family=if(match(os_norm,"(?i)windows"),"Windows","Linux")
| eval h=tonumber(substr(md5(nt_host),1,7),16)
| where (h%10)<6
| eval slots=case((h%17)<2,4,(h%7)<2,3,(h%3)<1,2,true(),1)
| eval slot=mvrange(0,slots)
| mvexpand slot
| eval pick=(h+slot*2654435761)%1000
| eval CVE=case(
    os_family=="Windows" AND pick<130,"CVE-2025-59287",
    os_family=="Windows" AND pick<250,"CVE-2025-29824",
    os_family=="Windows" AND pick<330,"CVE-2025-53770",
    os_family=="Windows" AND pick<400,"CVE-2025-49704",
    os_family=="Windows" AND pick<490,"CVE-2025-33053",
    os_family=="Windows" AND pick<580,"CVE-2025-26633",
    os_family=="Windows" AND pick<680,"CVE-2025-24071",
    os_family=="Windows" AND pick<760,"CVE-2025-21333",
    os_family=="Windows" AND pick<840,"CVE-2025-59230",
    os_family=="Windows" AND pick<900,"CVE-2025-24990",
    os_family=="Windows" AND pick<950,"CVE-2025-53786",
    os_family=="Windows","CVE-2025-55315",
    pick<150,"CVE-2025-32433",
    pick<330,"CVE-2025-32463",
    pick<480,"CVE-2025-24813",
    pick<580,"CVE-2025-31324",
    pick<680,"CVE-2025-61882",
    pick<840,"CVE-2025-29927",
    true(),"CVE-2025-55182")
| dedup nt_host CVE
| join type=inner CVE
    [| makeresults format=csv data="CVE,Plugin ID,Plugin Name,Plugin Family,CVSS v3.0 Base Score,CVSS v3.0 Vector,Risk,EPSS Score,EPSS Percentile,Port,Vulnerability Published,Patch Published,Synopsis,Solution
CVE-2025-59287,187210,Microsoft WSUS Deserialization of Untrusted Data RCE,Windows,9.8,CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H,Critical,0.8901,96,8530,2025-07-08,2025-07-08,Remote code execution via WSUS deserialization.,Apply July 2025 Microsoft security updates.
CVE-2025-29824,183100,Microsoft Windows CLFS Driver Use-After-Free EoP,Windows,7.8,CVSS:3.1/AV:L/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H,High,0.7912,93,0,2025-04-08,2025-04-08,Privilege escalation in the CLFS driver.,Apply April 2025 Microsoft security updates.
CVE-2025-53770,186102,Microsoft SharePoint Server ToolShell Deserialization RCE,Windows,9.8,CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H,Critical,0.9341,98,443,2025-07-19,2025-07-20,Unauthenticated RCE in on-prem SharePoint.,Apply July 2025 SharePoint emergency patch and rotate MachineKeys.
CVE-2025-49704,186090,Microsoft SharePoint Server Code Injection RCE,Windows,8.8,CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H,High,0.8523,95,443,2025-07-08,2025-07-08,Authenticated code injection in SharePoint.,Apply July 2025 SharePoint security updates.
CVE-2025-33053,185900,Microsoft Windows WebDAV External Control of File Name RCE,Windows,8.8,CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:U/C:H/I:H/A:H,High,0.7234,92,80,2025-06-10,2025-06-10,RCE via crafted WebDAV URL.,Apply June 2025 Microsoft security updates.
CVE-2025-26633,181755,Microsoft MMC Improper Neutralization MSC EvilTwin,Windows,7.0,CVSS:3.1/AV:L/AC:H/PR:N/UI:R/S:U/C:H/I:H/A:H,High,0.6512,89,0,2025-03-11,2025-03-11,Security feature bypass via crafted MSC console files.,Apply March 2025 Microsoft security updates.
CVE-2025-24071,181700,Microsoft Windows File Explorer NTLM Hash Leak,Windows,6.5,CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:U/C:H/I:N/A:N,Medium,0.5841,85,445,2025-03-11,2025-03-11,NTLM hash disclosure via crafted library-ms files.,Apply March 2025 Microsoft security updates.
CVE-2025-21333,180412,Microsoft Windows Hyper-V NT Kernel Integration VSP EoP,Windows,7.8,CVSS:3.1/AV:L/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H,High,0.6120,88,0,2025-01-14,2025-01-14,Heap buffer overflow in Hyper-V VSP enabling SYSTEM.,Apply January 2025 Microsoft security updates.
CVE-2025-59230,187302,Microsoft Windows Remote Access Connection Manager EoP,Windows,7.8,CVSS:3.1/AV:L/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H,High,0.5510,84,0,2025-10-14,2025-10-14,Improper access control in RasMan enabling elevation.,Apply October 2025 Microsoft security updates.
CVE-2025-24990,187310,Microsoft Windows Agere Modem Driver EoP,Windows,7.8,CVSS:3.1/AV:L/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H,High,0.5015,82,0,2025-10-14,2025-10-14,Vulnerable third-party ltmdm64 driver enables elevation.,Apply October 2025 updates removing the driver.
CVE-2025-53786,186550,Microsoft Exchange Server Hybrid Privilege Escalation,Windows,8.0,CVSS:3.1/AV:N/AC:H/PR:H/UI:N/S:C/C:H/I:H/A:H,High,0.4210,79,443,2025-08-06,2025-08-06,Hybrid Exchange trust abuse enabling cloud pivot.,Apply Exchange hotfix and dedicated hybrid app configuration.
CVE-2025-55315,187520,Microsoft ASP.NET Core Kestrel HTTP Request Smuggling,Windows,9.9,CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:C/C:H/I:H/A:H,Critical,0.4730,80,443,2025-10-14,2025-10-14,Request smuggling in Kestrel enabling security bypass.,Update ASP.NET Core to patched versions.
CVE-2025-32433,183600,Erlang OTP SSH Server Unauthenticated RCE,Misc.,10.0,CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:C/C:H/I:H/A:H,Critical,0.9612,99,22,2025-04-16,2025-04-16,Unauthenticated RCE in Erlang/OTP SSH daemon.,Upgrade OTP to 27.3.3 / 26.2.5.11 / 25.3.2.20 or later.
CVE-2025-32463,183900,Sudo chroot Privilege Escalation,Misc.,7.8,CVSS:3.1/AV:L/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H,High,0.7341,92,0,2025-06-30,2025-06-30,Local root via sudo --chroot untrusted control sphere.,Update sudo to 1.9.17p1 or later.
CVE-2025-24813,181500,Apache Tomcat Partial PUT Remote Code Execution,Web Servers,9.8,CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H,Critical,0.9023,97,8080,2025-03-10,2025-03-10,RCE via partial PUT and session deserialization.,Upgrade Tomcat to 11.0.3 / 10.1.35 / 9.0.99 or later.
CVE-2025-31324,183450,SAP NetWeaver Visual Composer Unrestricted File Upload RCE,CGI abuses,10.0,CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:C/C:H/I:H/A:H,Critical,0.9440,98,443,2025-04-24,2025-04-24,Unauthenticated file upload to metadatauploader enabling webshell.,Apply SAP note 3594142.
CVE-2025-61882,187650,Oracle E-Business Suite Concurrent Processing Unauthenticated RCE,CGI abuses,9.8,CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H,Critical,0.9215,97,8000,2025-10-04,2025-10-04,Unauthenticated RCE exploited by Cl0p against EBS.,Apply Oracle October 2025 emergency patch.
CVE-2025-29927,182100,Vercel Next.js Middleware Authorization Bypass,Web Servers,9.1,CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:N,Critical,0.8712,95,443,2025-03-21,2025-03-21,Middleware subrequest header bypasses authorization.,Upgrade Next.js to 15.2.3 / 14.2.25 or later.
CVE-2025-55182,185231,React Server Components RSC Payload Remote Code Execution,Web Servers,10.0,CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:C/C:H/I:H/A:H,Critical,0.9712,99,443,2025-12-03,2025-12-03,Crafted RSC payload enables server-side code execution.,Upgrade React and framework packages to patched releases.
CVE-2025-20363,179500,Cisco ASA and FTD Web Services Heap Overflow RCE,CISCO,9.0,CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:C/C:H/I:H/A:H,Critical,0.8234,94,443,2025-09-25,2025-09-25,Heap overflow in VPN web server enabling RCE.,Upgrade ASA/FTD per Cisco advisory." ]
| eval first_disc_epoch=now()-((h+slot*7919)%90)*86400 - 43200
| eval "First Discovered"=strftime(first_disc_epoch,"%Y-%m-%d")
| eval "Last Observed"=if(scan_state="current",strftime(now()-86400,"%Y-%m-%d"),strftime(lastseen_12,"%Y-%m-%d"))
| eval Host=nt_host
| eval "IP Address"=ip
| eval OS=os_norm
| eval Protocol="tcp"
| eval "Exploit Available"="true"
| eval "Exploit Ease"="Exploits are available"
| eval "Vulnerability State"="Active"
| eval "VPR Score"='CVSS v3.0 Base Score'
| eval Scanner="Tenable.io"
| table "Plugin ID" "Plugin Name" "Plugin Family" CVE "CVSS v3.0 Base Score" "CVSS v3.0 Vector" Risk "VPR Score" "EPSS Score" "EPSS Percentile" Host "IP Address" OS Protocol Port "Exploit Available" "Exploit Ease" "Vulnerability Published" "Patch Published" "First Discovered" "Last Observed" "Vulnerability State" Synopsis Solution Scanner
| outputlookup asset_vulnerability_data.csv
